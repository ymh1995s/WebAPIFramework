<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Configurations>Debug;Release;LoadTest</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Framework.Application\Framework.Application.csproj" />
    <ProjectReference Include="..\Framework.Domain\Framework.Domain.csproj" />
  </ItemGroup>

  <!-- 부하테스트 전용 빌드 구성. VS 드롭다운에서 LoadTest 선택 시에만 적용 (Api와 동형) -->
  <PropertyGroup Condition="'$(Configuration)' == 'LoadTest'">
    <!-- LOADTEST 심볼 정의 → 코드의 #if LOADTEST / #if DEBUG || LOADTEST 블록 활성화 -->
    <DefineConstants>LOADTEST</DefineConstants>
    <!-- 컴파일 최적화 ON — 부하테스트는 실성능 측정이라 Release급 빌드 필요 -->
    <Optimize>true</Optimize>
    <!-- 디버그 심볼 형식 지정 (portable: 크로스플랫폼 표준 포맷) -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
