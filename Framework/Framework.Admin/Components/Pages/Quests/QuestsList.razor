@page "/quests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits SafeComponentBase
@using Framework.Admin.Constants
@using Framework.Application.Common
@using Framework.Domain.Enums

<PageTitle>퀘스트 관리</PageTitle>

<h2 class="mb-2">퀘스트 관리</h2>

<div class="alert alert-info py-2 small mb-3">
    <p class="mb-1">일일/주간/메인 퀘스트 조건과 보상 테이블을 정의합니다.</p>
    <p class="mb-1"><strong>[조건 대상 ID]</strong> 조건 타입에 따라 의미가 달라집니다 (스테이지 / 아이템 / 상점 상품, Login은 해당 없음)</p>
    <p class="mb-1"><strong>[RewardTableId]</strong> 퀘스트 완료 시 지급할 보상 테이블 (SourceType=QuestComplete만 노출)</p>
    <p class="mb-0"><strong>[선행 퀘스트]</strong> 선택 시 해당 퀘스트 완료 후에만 본 퀘스트 진행 가능</p>
</div>

<!-- 검색 필터 카드 -->
<section class="card mb-3">
    <div class="card-header py-2"><strong>검색 필터</strong></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small mb-1">키워드 (제목/코드)</label>
                <input type="text" class="form-control form-control-sm" @bind="filterKeyword" placeholder="제목 또는 코드 검색" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">주기</label>
                <select class="form-select form-select-sm" @bind="filterPeriod">
                    <option value="">전체</option>
                    @foreach (var opt in QuestPeriodMeta.AllOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">활성 여부</label>
                <select class="form-select form-select-sm" @bind="filterIsActive">
                    <option value="">전체</option>
                    <option value="true">활성</option>
                    <option value="false">비활성</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">페이지 크기</label>
                <input type="number" class="form-control form-control-sm" @bind="pageSize" min="10" max="100" />
            </div>
        </div>
    </div>
    <div class="card-footer py-2 d-flex gap-2">
        <button class="btn btn-primary btn-sm" @onclick="Search">조회</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Reset">초기화</button>
        <button class="btn btn-success btn-sm ms-auto" @onclick="OpenCreateModal">+ 퀘스트 추가</button>
    </div>
</section>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger py-2 small">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success py-2 small">@successMessage</div>
}

@if (isLoading)
{
    <p class="text-muted">불러오는 중...</p>
}
else if (result == null)
{
    <p class="text-muted">상단 필터를 설정한 후 <strong>조회</strong> 버튼을 눌러주세요.</p>
}
else if (!result.Items.Any())
{
    <p class="text-muted">조건에 맞는 퀘스트가 없습니다.</p>
}
else
{
    <div class="d-flex align-items-center mb-2">
        <span class="small text-muted ms-auto">총 <strong>@result.TotalCount</strong> 건</span>
    </div>

    <table class="table table-sm table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>코드</th>
                <th>제목</th>
                <th>주기</th>
                <th>조건 타입</th>
                <th>목표</th>
                <th>RewardTableId</th>
                <th>선행 퀘스트</th>
                <th>활성</th>
                <th>정렬</th>
                <th>관리</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in result.Items)
            {
                <tr>
                    <td>@q.Id</td>
                    <td><code>@q.Code</code></td>
                    <td><strong>@q.Title</strong></td>
                    <td>@PeriodLabel(q.Period)</td>
                    <td>@ConditionLabel(q.ConditionType)</td>
                    <td>@q.TargetAmount</td>
                    <td>@q.RewardTableId</td>
                    <td>@(q.PrerequisiteQuestId.HasValue ? q.PrerequisiteQuestId.Value.ToString() : "-")</td>
                    <td>
                        @if (q.IsActive && !q.IsDeleted)
                        {
                            <span class="badge bg-success">활성</span>
                        }
                        else if (q.IsDeleted)
                        {
                            <span class="badge bg-danger">삭제됨</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">비활성</span>
                        }
                    </td>
                    <td>@q.SortOrder</td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditModal(q)">편집</button>
                        @if (!q.IsDeleted)
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(q)">삭제</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- 페이지네이션 -->
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage" disabled="@(page <= 1)">이전</button>
        <span class="small">@(page) / @(result.TotalPages) 페이지</span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(page >= result.TotalPages)">다음</button>
    </div>
}

<!-- 생성 모달 -->
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">퀘스트 추가</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">코드 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" @bind="newCode" placeholder="예: daily_login_3" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">제목 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" @bind="newTitle" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">설명</label>
                        <input type="text" class="form-control form-control-sm" @bind="newDescription" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">주기 <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" @bind="newPeriod">
                            @foreach (var opt in QuestPeriodMeta.AllOptions)
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">조건 타입 <span class="text-danger">*</span></label>
                        <!-- 조건 타입 변경 시 대상 ID를 null로 리셋 -->
                        <select class="form-select form-select-sm" @bind="newConditionType" @bind:after="OnNewConditionTypeChanged">
                            @foreach (var opt in QuestConditionTypeMeta.AllOptions)
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <!-- 조건 대상 ID — 조건 타입에 따라 드롭다운 내용 변경 -->
                    @if (!NewConditionRequiresTarget)
                    {
                        <!-- Login 타입은 대상 없음 — null 고정 -->
                        <div class="mb-2">
                            <label class="form-label small">조건 대상</label>
                            <p class="form-control-plaintext form-control-sm text-muted">(해당 없음 — null로 고정)</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label small">조건 대상 <span class="text-muted">(null=전체 대상)</span></label>
                            <select class="form-select form-select-sm" @bind="newConditionTargetId">
                                <option value="">@("(전체 대상 — null)")</option>
                                @if (newConditionType == 1)
                                {
                                    <!-- 스테이지 클리어 — "[Code] Name" 형식 -->
                                    @foreach (var s in allStages)
                                    {
                                        <option value="@s.Id">[@s.Code] @s.Name</option>
                                    }
                                }
                                else if (newConditionType == 2)
                                {
                                    <!-- 아이템 사용 — "Name (ItemType)" 형식 -->
                                    @foreach (var item in allItems.Where(i => !i.IsDeleted))
                                    {
                                        <option value="@item.Id">@item.Name (@item.ItemType)</option>
                                    }
                                }
                                else if (newConditionType == 3)
                                {
                                    <!-- 상점 구매 — "Name" 형식 -->
                                    @foreach (var sp in allShopProducts.Where(sp => sp.IsEnabled))
                                    {
                                        <option value="@sp.Id">@sp.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small">목표 수량 <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" @bind="newTargetAmount" min="1" />
                    </div>
                    <!-- 보상 테이블 드롭다운 — SourceType=QuestComplete(2)만 표시 -->
                    <div class="mb-2">
                        <label class="form-label small">보상 테이블 <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" @bind="newRewardTableId">
                            <option value="0">(선택해주세요)</option>
                            @foreach (var rt in allRewardTables.Where(r => !r.IsDeleted))
                            {
                                <option value="@rt.Id">@RewardTableLabel(rt)</option>
                            }
                        </select>
                    </div>
                    <!-- 선행 퀘스트 드롭다운 — 활성 퀘스트 전체 -->
                    <div class="mb-2">
                        <label class="form-label small">선행 퀘스트 <span class="text-muted">(미선택=없음)</span></label>
                        <select class="form-select form-select-sm" @bind="newPrerequisiteQuestId">
                            <option value="">(선행 조건 없음)</option>
                            @foreach (var q in allActiveQuests)
                            {
                                <option value="@q.Id">@QuestDropdownLabel(q)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">정렬 순서</label>
                        <input type="number" class="form-control form-control-sm" @bind="newSortOrder" min="0" />
                    </div>
                    <div class="mb-2 form-check">
                        <input type="checkbox" class="form-check-input" id="newIsActive" @bind="newIsActive" />
                        <label class="form-check-label small" for="newIsActive">활성화</label>
                    </div>
                    @if (!string.IsNullOrEmpty(createError))
                    {
                        <div class="alert alert-danger py-1 small">@createError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseCreateModal">취소</button>
                    <button class="btn btn-success btn-sm" @onclick="Create">생성</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 편집 모달 -->
@if (showEditModal && editingQuest != null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">퀘스트 편집 — @editingQuest.Code</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">제목</label>
                        <input type="text" class="form-control form-control-sm" @bind="editTitle" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">설명</label>
                        <input type="text" class="form-control form-control-sm" @bind="editDescription" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">조건 타입</label>
                        <!-- 조건 타입 변경 시 대상 ID를 null로 리셋 -->
                        <select class="form-select form-select-sm" @bind="editConditionType" @bind:after="OnEditConditionTypeChanged">
                            @foreach (var opt in QuestConditionTypeMeta.AllOptions)
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <!-- 조건 대상 ID — 조건 타입에 따라 드롭다운 내용 변경 -->
                    @if (!EditConditionRequiresTarget)
                    {
                        <!-- Login 타입은 대상 없음 — null 고정 -->
                        <div class="mb-2">
                            <label class="form-label small">조건 대상</label>
                            <p class="form-control-plaintext form-control-sm text-muted">(해당 없음 — null로 고정)</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label small">조건 대상 <span class="text-muted">(null=전체 대상)</span></label>
                            <select class="form-select form-select-sm" @bind="editConditionTargetId">
                                <option value="">@("(전체 대상 — null)")</option>
                                @if (editConditionType == 1)
                                {
                                    <!-- 스테이지 클리어 — "[Code] Name" 형식 -->
                                    @foreach (var s in allStages)
                                    {
                                        <option value="@s.Id">[@s.Code] @s.Name</option>
                                    }
                                }
                                else if (editConditionType == 2)
                                {
                                    <!-- 아이템 사용 — "Name (ItemType)" 형식 -->
                                    @foreach (var item in allItems.Where(i => !i.IsDeleted))
                                    {
                                        <option value="@item.Id">@item.Name (@item.ItemType)</option>
                                    }
                                }
                                else if (editConditionType == 3)
                                {
                                    <!-- 상점 구매 — "Name" 형식 -->
                                    @foreach (var sp in allShopProducts.Where(sp => sp.IsEnabled))
                                    {
                                        <option value="@sp.Id">@sp.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label small">목표 수량</label>
                        <input type="number" class="form-control form-control-sm" @bind="editTargetAmount" min="1" />
                    </div>
                    <!-- 보상 테이블 드롭다운 — SourceType=QuestComplete(2)만 표시 -->
                    <div class="mb-2">
                        <label class="form-label small">보상 테이블</label>
                        <select class="form-select form-select-sm" @bind="editRewardTableId">
                            <option value="0">(선택해주세요)</option>
                            @foreach (var rt in allRewardTables.Where(r => !r.IsDeleted))
                            {
                                <option value="@rt.Id">@RewardTableLabel(rt)</option>
                            }
                        </select>
                    </div>
                    <!-- 선행 퀘스트 드롭다운 — 자기 자신 제외 (순환 참조 방지) -->
                    <div class="mb-2">
                        <label class="form-label small">선행 퀘스트 <span class="text-muted">(미선택=없음)</span></label>
                        <select class="form-select form-select-sm" @bind="editPrerequisiteQuestId">
                            <option value="">(선행 조건 없음)</option>
                            @foreach (var q in allActiveQuests.Where(q => q.Id != editingQuest.Id))
                            {
                                <option value="@q.Id">@QuestDropdownLabel(q)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">정렬 순서</label>
                        <input type="number" class="form-control form-control-sm" @bind="editSortOrder" min="0" />
                    </div>
                    <div class="mb-2 form-check">
                        <input type="checkbox" class="form-check-input" id="editIsActive" @bind="editIsActive" />
                        <label class="form-check-label small" for="editIsActive">활성화</label>
                    </div>
                    @if (!string.IsNullOrEmpty(editError))
                    {
                        <div class="alert alert-danger py-1 small">@editError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseEditModal">취소</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveEdit">저장</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 삭제 확인 모달 -->
@if (showDeleteModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">퀘스트 삭제 확인</h5>
                </div>
                <div class="modal-body">
                    <p><strong>@deletingCode</strong> 퀘스트를 삭제하시겠습니까?</p>
                    <p class="text-muted small">소프트 삭제로 처리됩니다. (DB 행은 유지)</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CancelDelete">취소</button>
                    <button class="btn btn-danger btn-sm" @onclick="ConfirmDelete">삭제</button>
                </div>
            </div>
        </div>
    </div>
}
