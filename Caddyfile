# ─────────────────────────────────────────────────────────────
# Caddy 리버스 프록시 설정
#
# api.overture.io.kr 로 들어오는 외부 요청을 도커 내부 api 컨테이너
# (서비스명 api, 포트 8080)로 전달한다. 도메인을 명시하면 Caddy 가
# Let's Encrypt 인증서를 자동 발급/갱신(ACME)하고 HTTP→HTTPS 리다이렉트.
#
# [전제] 공인 DNS api.overture.io.kr → 이 호스트, 80/443 개방.
#        사설/로컬에선 인증서 발급만 실패(내부 프록시 동작은 정상).
# [실제 클라이언트 IP] Caddy 가 X-Forwarded-For/-Proto 자동 부착,
#        API 의 ForwardedHeaders 가 이를 복원(Program.cs 참조).
# ─────────────────────────────────────────────────────────────

api.overture.io.kr {
	# 내부 api 컨테이너로 프록시 (compose 네트워크 서비스명 해석)
	reverse_proxy api:8080
}
